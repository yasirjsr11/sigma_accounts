# TEST environment — copy to .env and replace CHANGE_ME values. Never commit .env.
NODE_ENV=development
HOST=127.0.0.1
PORT=4001
DB_CLIENT=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sh_pms_test
DB_USER=SH_PMS
DB_PASSWORD=CHANGE_ME
DB_TIMEZONE=+04:00
DB_QUERY_TIMEOUT_MS=60000
SESSION_SECRET=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
UPLOAD_PATH=C:\xampp\htdocs\SH_PMS\uploads
BACKUP_DIR=C:\xampp\htdocs\SH_PMS\backups
BACKUP_DB_USER=SH_PMS
BACKUP_DB_PASSWORD=CHANGE_ME
BACKUP_LOCAL_KEEP=14
BACKUP_SCHEDULE=off
MYSQLDUMP_PATH=C:\xampp\mysql\bin\mysqldump.exe
ARCHIVE_TOOL_PATH=C:\Windows\System32\tar.exe
